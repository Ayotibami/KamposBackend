{
  "name": "jit-server",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --minify --target=bun",
    "start": "bun run build --target=bun && bun run dist/index.js | pino-pretty",
    "dev": "nodemon --watch src --ext ts --exec bun run /src/index.ts | pino-pretty",
    "test": "bun test",
    "lint": "bun run lint"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express-fileupload": "^1.5.1",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "jest": "^30.0.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@sentry/node": "^10.5.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.17",
    "@types/otp-generator": "^4.0.2",
    "bullmq": "^5.58.0",
    "bun": "^1.2.20",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "envalid": "^8.0.0",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.0.1",
    "google-auth-library": "^10.2.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.1",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.0",
    "nodemon": "^3.1.10",
    "otp-generator": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "redis": "^5.8.1",
