{
  "name": "kamposbackend",
  "version": "1.0.0",
  "description": "Backend stack - Bun + Express 5 + TypeScript - PostgreSQL (raw `pg`, no ORM) + Redis - Vitest + Supertest - WebSockets (`ws`) + Redis-backed pub/sub - GraphQL (feeds only) - Email (Brevo SMTP) + Push (FCM)",
  "homepage": "https://github.com/Ayotibami/KamposBackend#readme",
  "bugs": {
    "url": "https://github.com/Ayotibami/KamposBackend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayotibami/KamposBackend.git"
  },
  "license": "ISC",
  "author": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-dev-data.ts",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "bullmq": "^5.58.5",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "envalid": "^8.1.0",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.2",
    "express-graphql": "^0.12.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.3.0",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.6",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "otp-generator": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-fileupload": "^1.5.1",
    "@types/handlebars": "^4.0.40",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
