# Kampos Backend - Environment Example

# Server
PORT=8080
NODE_ENV=development
CORS_ORIGIN=*
SERVER_BASE_URL=http://localhost:8080
CLIENT_BASE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_URI=postgres://user:password@localhost:5432/kampos

# JWT (30 days ~ 2592000 seconds)
JWT_SECRET=change_me
JWT_EXPIRES=2592000
REFRESH_TOKEN_SECRET=change_me_refresh
REFRESH_TOKEN_EXPIRES_DAYS=30

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost

# Email (Brevo SMTP)
BREVO_EMAIL=apikey
BREVO_PASSWORD=your_brevo_smtp_key

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Sentry (optional)
SENTRY_DSN=

# Push Notifications
FCM_SERVER_KEY=
